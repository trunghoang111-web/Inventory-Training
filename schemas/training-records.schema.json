{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asv-training-records.schema.json",
  "title": "ASV training authoring contracts",
  "type": "object",
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "pool",
        "lesson_id",
        "type",
        "critical",
        "stem_vi",
        "options",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "single_choice"
        },
        "critical": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text_vi"
            ]
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "order",
        "title_vi",
        "minutes",
        "cards",
        "narration_vi",
        "asset_ids",
        "knowledge_check_ids",
        "source_refs"
      ],
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "headline_vi",
              "text_vi"
            ]
          }
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "id",
        "crew",
        "group",
        "start_at",
        "end_at",
        "timezone",
        "kind",
        "conditional",
        "status"
      ],
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Ho_Chi_Minh"
        },
        "conditional": {
          "type": "boolean"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "attempt_id",
        "criterion_id",
        "pass"
      ],
      "properties": {
        "pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "criterion_id": {
          "type": "string"
        }
      }
    }
  }
}
